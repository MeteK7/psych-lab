# Copy to .env (git-ignored) and fill in the local postgres password.
# Percent-encode special characters in the password inside URLs:
#   @ -> %40   : -> %3A   / -> %2F   % -> %25   # -> %23   $ -> %24   > -> %3E
#
# Two environments (docs/runbook.md, "Environments"); each folder has its own .env.
# The server refuses to start if one environment's settings point at the other's data.

# --- Development: C:\Projects\new_project\platform (branch test) ---
APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/app_dev
TEST_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/app_test
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:4310
# Development runs Test mode only (phase 0); its schedule and study log live in data/.
N1_PHASE=0
STUDY_TIMEZONE=Europe/Istanbul
# The booth profile (docs/runbook.md, "The booth profile"); standard unless set.
# APP_PROFILE=booth
# BOOTH_SUPPORT_LINE=
# BOOTH_IDLE_SECONDS=180

# --- Production: C:\Projects\new_project\platform-prod (main), runs the n-of-1 ---
# APP_ENV=production
# DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/app_prod
# TEST_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/app_test_main
# ALLOWED_HOSTS=localhost,127.0.0.1
# ALLOWED_ORIGINS=http://localhost:4300
# N1_PHASE=1
# STUDY_TIMEZONE=Europe/Istanbul
