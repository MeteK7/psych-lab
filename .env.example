# Copy to .env (git-ignored) and fill in the local postgres password.
# Percent-encode special characters in the password inside URLs:
#   @ -> %40   : -> %3A   / -> %2F   % -> %25   # -> %23   $ -> %24   > -> %3E
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/app_dev
TEST_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/app_test
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:4300
# n-of-1: current phase (0 = test phase), local time zone for all dates.
N1_PHASE=1
STUDY_TIMEZONE=Europe/Istanbul
